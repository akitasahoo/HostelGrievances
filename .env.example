HOSTEL_API_PORT=3001
HOSTEL_API_HOST=0.0.0.0
HOSTEL_DB_PATH=data/hostel.db
HOSTEL_UPLOADS_DIR=uploads
# Comma-separated extra browser origins allowed for CORS and CSRF checks.
# localhost:5173, 127.0.0.1:5173, localhost:5174, 127.0.0.1:5174 are always included.
HOSTEL_CORS_ORIGINS=http://localhost:5173
# Set true when serving the API over HTTPS.
HOSTEL_COOKIE_SECURE=false
# Session lifetime in seconds (default 8 hours).
HOSTEL_SESSION_TTL=28800
